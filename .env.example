# ====================================================================
# ITI Bus Booking Agent - Environment Configuration
# ====================================================================

# ITI origin; do not append /api/v1 here
ITI_BASE_URL=https://schedule.iti.gov.eg
DASHBOARD_PATH=/dashboard

# ====================================================================
# Monitoring & Scheduling Preferences
# ====================================================================
# Target timezone (handles Egyptian DST transitions automatically)
TIMEZONE=Africa/Cairo

# Daily schedule start time in 24-hour format (HH:MM Cairo time)
DAILY_START_TIME=11:45

# If true, agent sleeps until DAILY_START_TIME when started prior to it.
# If false, begins monitoring immediately upon launch.
WAIT_FOR_SCHEDULE=true

# Polling interval in milliseconds (minimum 15000; default 30000 = 30s)
POLL_INTERVAL_MS=30000

# Comma-separated offsets from today's Africa/Cairo date.
# 0,1,2,3,4,5,6,7 watches today through 7 days ahead.
WATCH_DATE_OFFSETS=0,1,2,3,4,5,6,7

# ====================================================================
# Trip Matching Preferences
# ====================================================================
# Route name keyword (Arabic diacritic and spelling variants normalized)
ROUTE_KEYWORD=6 أكتوبر

# Pickup location keyword
PICKUP_KEYWORD=ليلة القدر

# Trip direction: 'return', 'outbound', or 'either'
DIRECTION=return

# ====================================================================
# Automatic Booking Mode
# ====================================================================
# When false: Dry-run safe mode (monitors and logs matching trips without booking).
# When true: Automatically books matching trips via POST /api/v1/bookings.
# Keep false until the non-empty available trips schema is verified on your account.
BOOKING_ENABLED=false

# ====================================================================
# Storage & Database
# ====================================================================
# SQLite database file for tracking booking attempts and preventing duplicates
DATABASE_PATH=./data/bookings.db

# ====================================================================
# Telegram Notifications (Optional but recommended)
# ====================================================================
# Create a bot via @BotFather on Telegram and paste token below
TELEGRAM_BOT_TOKEN=token
# Your personal Telegram chat ID or channel ID (obtain via @userinfobot)
TELEGRAM_CHAT_ID=token

# ====================================================================
# Rate Limiting & Reliability
# ====================================================================
# Maximum requests within the rate limit window (ITI limit: 30 requests per 60s)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=15000

# ====================================================================
# Browser Context & Headless Profile
# ====================================================================
# Persistent Playwright profile storage. Never commit this directory.
BROWSER_PROFILE_DIR=./data/browser-profile
HEADLESS=true
LOG_LEVEL=info
